+// MARK: AyuGram
+// Temporary startup diagnostic: shows a red overlay for 20 seconds so a
+// sideloaded build can report how far it got without a crash log.
+private var ayuDiagnosticWindow: UIWindow?
+private func ayuShowDiagnostic(_ message: String) {
+    let window = UIWindow(frame: UIScreen.main.bounds)
+    window.windowLevel = UIWindow.Level.alert + 1
+    let controller = UIViewController()
+    controller.view.backgroundColor = UIColor(red: 0.15, green: 0.0, blue: 0.0, alpha: 0.96)
+    let label = UILabel(frame: CGRect(x: 20.0, y: 80.0, width: UIScreen.main.bounds.width - 40.0, height: UIScreen.main.bounds.height - 160.0))
+    label.numberOfLines = 0
+    label.textColor = .white
+    label.font = UIFont.systemFont(ofSize: 14.0)
+    label.text = "AyuGram diagnostic\n\n" + message
+    controller.view.addSubview(label)
+    window.rootViewController = controller
+    window.isHidden = false
+    window.makeKeyAndVisible()
+    ayuDiagnosticWindow = window
+    DispatchQueue.main.asyncAfter(deadline: .now() + 20.0) {
+        window.isHidden = true
+        ayuDiagnosticWindow = nil
+    }
+}
